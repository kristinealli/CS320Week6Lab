[wordpress]

user = {{ wordpress_system.user }}
group =  {{ wordpress_system.group }}

listen = {{ php_fpm_socket }}
listen.owner = {{ wordpress_system.user }}
listen.group = {{ nginx_user }}
listen.mode = 0660

pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3